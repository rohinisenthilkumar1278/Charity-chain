# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string (MongoDB Atlas or local mongod)
MONGO_URI=mongodb://127.0.0.1:27017/charitychain

# Port the Express API listens on
PORT=5000

# Comma-separated list of origins allowed to call this API (your frontend dev/prod URLs)
CORS_ORIGIN=http://localhost:5173

# Wallet address(es) allowed to hit admin-only routes (lowercase, comma-separated).
# This is a simple allowlist check for Phase 1 -- swap for real auth (JWT/session) later if needed.
ADMIN_WALLETS=0xyourAdminWalletHere
